nav{position:sticky;top:0;z-index:100;background:rgba(244,241,236,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);padding:0 6vw;display:flex;align-items:center;justify-content:space-between;height:60px}
nav img{height:34px;width:auto}
.nav-links{display:flex;align-items:center;gap:26px}
.nav-links a{font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink);text-decoration:none;font-weight:400;opacity:.7;transition:opacity .15s}
.nav-links a:hover{opacity:1}.nav-links a.active{opacity:1;color:var(--bordeaux)}
.nav-right{display:flex;align-items:center;gap:14px}
.nav-portal{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;background:var(--bordeaux);color:#fff;padding:7px 14px;border-radius:5px;text-decoration:none;font-weight:500;transition:background .15s}
.nav-portal:hover{background:#7a2436}
.lang-pills{display:flex;gap:5px}
.lang-pill{border:1px solid var(--line);border-radius:16px;padding:3px 11px;font-size:11px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;background:var(--paper);color:var(--grey);transition:background .15s,color .15s,border-color .15s;font-family:'Jost',sans-serif}
.lang-pill.active{background:var(--bordeaux);color:#fff;border-color:var(--bordeaux)}
.lang-pill:hover:not(.active){border-color:var(--bordeaux);color:var(--bordeaux)}
.hero{padding:5.5rem 6vw 4rem;max-width:900px;animation:riseIn .9s ease both}
@keyframes riseIn{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
.eyebrow{font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;color:var(--bordeaux);display:flex;align-items:center;gap:12px;margin-bottom:1.4rem;font-weight:400}
.eyebrow::before{content:'';width:28px;height:1px;background:var(--bordeaux)}
.hero h1{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(2.4rem,6vw,4.2rem);line-height:1.12;color:var(--ink);margin-bottom:1.4rem;max-width:780px}
.hero h1 em{color:var(--bordeaux);font-style:italic}
.hero>p{font-size:1.05rem;line-height:1.75;max-width:52ch;color:#3a3530;margin-bottom:2.2rem}
.cta-group{display:flex;flex-wrap:wrap;gap:14px;align-items:center}
.btn{border:none;border-radius:6px;padding:14px 22px;font-size:12px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;font-family:'Jost',sans-serif;transition:transform .12s,box-shadow .12s;text-decoration:none;display:inline-flex;align-items:center;gap:9px}
.btn-primary{background:linear-gradient(180deg,#7a2436,var(--bordeaux));color:#fff;box-shadow:0 3px 10px rgba(107,30,46,.25)}
.btn-primary:hover{box-shadow:0 5px 14px rgba(107,30,46,.32);transform:translateY(-1px)}
.btn-ghost{background:transparent;border:1px solid var(--bordeaux);color:var(--bordeaux)}
.btn-ghost:hover{background:rgba(107,30,46,.04);transform:translateY(-1px)}
.divider{width:48px;height:1px;background:var(--gold);margin:0 6vw 3.5rem}
section{padding:3.5rem 6vw}
.section-label{font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font-weight:500;margin-bottom:.9rem;display:block}
section h2{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(1.8rem,3.5vw,2.6rem);margin-bottom:1rem}
section>p{font-size:.97rem;line-height:1.75;max-width:52ch;color:#3a3530;margin-bottom:2.4rem}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px;margin-top:2rem}
.step{background:#fff;border:1px solid var(--line);border-radius:10px;padding:24px;box-shadow:0 2px 10px rgba(14,14,14,.045);transition:box-shadow .15s,transform .15s}
.step:hover{box-shadow:0 5px 18px rgba(107,30,46,.1);transform:translateY(-2px)}
.step-num{font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:400;font-size:2.8rem;color:var(--gold);opacity:.55;display:block;margin-bottom:.5rem;line-height:1}
.step h3{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:1.2rem;color:var(--bordeaux);margin-bottom:.6rem}
.step p{font-size:.88rem;line-height:1.65;color:#4a443e}
.benefits{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-top:2rem}
.benefit{background:linear-gradient(180deg,#fff,#fdfbf9);border:1px solid var(--line);padding:20px 22px;border-left:3px solid var(--bordeaux);border-radius:2px 10px 10px 2px;box-shadow:0 2px 10px rgba(14,14,14,.04)}
.benefit-icon{font-size:1.4rem;margin-bottom:.8rem;display:block}
.benefit h3{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:1.1rem;color:var(--bordeaux);margin-bottom:.4rem}
.benefit p{font-size:.87rem;line-height:1.6;color:#4a443e}
.products{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-top:2rem}
.product{background:#fff;border:1px solid var(--line);border-radius:10px;padding:20px 16px;text-align:center;box-shadow:0 2px 10px rgba(14,14,14,.035);transition:box-shadow .15s,transform .15s}
.product:hover{box-shadow:0 4px 16px rgba(107,30,46,.1);transform:translateY(-2px)}
.product-icon{font-size:2rem;display:block;margin-bottom:.7rem}
.product span{font-size:.82rem;letter-spacing:.06em;text-transform:uppercase;font-weight:500;color:var(--bordeaux)}
.exclusivity{background:linear-gradient(180deg,#7a2436,var(--bordeaux));color:#fff;border-radius:10px;padding:36px 40px;margin:3.5rem 6vw;box-shadow:0 4px 18px rgba(107,30,46,.3)}
.exclusivity .section-label{color:rgba(169,128,90,.85)}
.exclusivity h2{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(1.6rem,3vw,2.2rem);margin-bottom:.9rem;color:#fff}
.exclusivity p{font-size:.95rem;line-height:1.75;color:rgba(255,255,255,.82);max-width:56ch}
.terms-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:2rem}
.term{background:#fdfaf0;border:1px solid rgba(169,128,90,.3);border-radius:10px;padding:18px 20px}
.term .term-label{font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:#8a6a1e;font-weight:500;margin-bottom:.5rem;display:block}
.term p{font-size:.88rem;line-height:1.55;color:#5a4327;font-weight:400}
.photo-callout{background:#fff;border:1px solid var(--line);border-radius:12px;padding:36px 40px;margin:0 6vw 3.5rem;display:flex;align-items:center;justify-content:space-between;gap:32px;box-shadow:0 2px 14px rgba(14,14,14,.06);flex-wrap:wrap}
.photo-callout-text .callout-label{font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font-weight:500;margin-bottom:.7rem;display:block}
.photo-callout-text h2{font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(1.5rem,3vw,2rem);color:var(--ink);margin-bottom:.65rem}
